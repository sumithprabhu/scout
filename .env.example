# ---- Database ----
# Local:  mongodb://127.0.0.1:27017/job-matcher
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>/job-matcher?retryWrites=true&w=majority
MONGODB_URI=

# ---- AWS Bedrock (JD parsing via Amazon Nova) ----
# Standard AWS creds — the AWS SDK reads these from the environment. Needs an IAM
# principal with bedrock:InvokeModel, AND Nova model access enabled in the
# Bedrock console (Model access) for BEDROCK_REGION.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=            # only if using temporary/STS credentials
BEDROCK_REGION=us-east-1
# Nova model for JD extraction. Options: amazon.nova-micro-v1:0 (cheapest),
# amazon.nova-lite-v1:0 (default), amazon.nova-pro-v1:0 (best quality).
# If you get "on-demand throughput isn't supported", use the cross-region
# inference profile id instead, e.g. us.amazon.nova-lite-v1:0
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0

# ---- Bright Data Scraper Studio ----
# API token from the Bright Data control panel (Settings > API tokens).
# Used by /lib/scrapers to trigger collectors programmatically over the REST API.
BRIGHTDATA_API_KEY=

# Collector (dataset) IDs — one per source, printed by the CLI when you deploy each collector.
# Fill these in after step 3 (see README collector map).
BRIGHTDATA_COLLECTOR_GREENHOUSE=
BRIGHTDATA_COLLECTOR_LEVER=
BRIGHTDATA_COLLECTOR_WORKDAY=
BRIGHTDATA_COLLECTOR_NAUKRI=

# ---- Company-intelligence engine (pivot) ----
# ONE reusable collector that extracts nav + footer links from any company
# homepage. Build it once (free): `npx tsx scrapers/build-discovery-collector.ts`,
# then paste the printed id here. Reused for every company's homepage.
BRIGHTDATA_COLLECTOR_DISCOVERY=
# Max POST /api/companies per identity/day (each triggers discovery + collector
# builds + scheduled scrape cost). Protects the Bright Data balance.
COMPANY_RATE_LIMIT_PER_DAY=10

# ---- Rate limiting ----
# Max /api/scrape requests per identity (IP or email) per day. Protects Bright Data credits.
SCRAPE_RATE_LIMIT_PER_DAY=25

# Public origin Bright Data delivers webhooks to (ngrok/cloudflared tunnel in dev,
# deployment origin in prod). Used to build each collector's --deliver-webhook.
PUBLIC_BASE_URL=
# Shared secret baked into the delivery URL; the webhook route rejects mismatches.
WEBHOOK_SECRET=
